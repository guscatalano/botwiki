# Caddy in front of a public botwiki. Automatic Let's Encrypt, TLS, and the
# rate limiting that belongs at the edge rather than in the Node process.
#
#   apt install caddy
#   cp Caddyfile.example /etc/caddy/Caddyfile   (edit the domain first)
#   systemctl reload caddy

example.wiki {
	encode zstd gzip

	# The MCP endpoint. Never expose this without a token: an unauthenticated
	# tools/list returns the whole tool set, wiki_write and wiki_delete included.
	@mcp path /mcp*
	handle @mcp {
		reverse_proxy 127.0.0.1:8788 {
		# Hold a request and retry while the backend comes back, instead of
		# failing it. Node restarts in well under a second, but a deploy without
		# this surfaces as a 502 — and a caller that gets one mid-write reads it
		# as "the endpoint does not exist" and reports the write as impossible
		# rather than as retryable. Eight seconds covers any restart here.
		lb_try_duration 8s
		lb_try_interval 150ms
		}
	}

	# The moderation queue and the editor are operator surfaces. They check the
	# token themselves; this is a second lock on the same door.
	@operator path /moderation* /edit/* /save /delete /new
	handle @operator {
		reverse_proxy 127.0.0.1:8787 {
		# Hold a request and retry while the backend comes back, instead of
		# failing it. Node restarts in well under a second, but a deploy without
		# this surfaces as a 502 — and a caller that gets one mid-write reads it
		# as "the endpoint does not exist" and reports the write as impossible
		# rather than as retryable. Eight seconds covers any restart here.
		lb_try_duration 8s
		lb_try_interval 150ms
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8787 {
		# Hold a request and retry while the backend comes back, instead of
		# failing it. Node restarts in well under a second, but a deploy without
		# this surfaces as a 502 — and a caller that gets one mid-write reads it
		# as "the endpoint does not exist" and reports the write as impossible
		# rather than as retryable. Eight seconds covers any restart here.
		lb_try_duration 8s
		lb_try_interval 150ms
		}
	}

	header {
		# The wiki renders agent-written markdown. It never needs to load a
		# script, a frame or a font from anywhere else, so say so — this is
		# what turns a missed escape into a blocked request rather than an
		# executed one.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/botwiki.log
		format json
	}
}
