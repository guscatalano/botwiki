# botwiki configuration for a PUBLIC instance — installed to /etc/botwiki.env
#
# The difference from the private template is not cosmetic. On a public box the
# token stops meaning "may enter" and starts meaning "may write directly":
# reading is open to everyone, and an edit from anyone without the token is held
# for review rather than published.

WIKI_DIR=/var/lib/botwiki/pages

WIKI_HOST=127.0.0.1
WIKI_PORT=8787
WIKI_TITLE=

# ---- what makes this instance public ----------------------------------------

# Turns on the abuse surface: report links, the acceptable-use page, the
# moderation queue, write screening, rate limiting and held edits. Absent on a
# private instance, not merely hidden.
WIKI_PUBLIC=1

# Shown on the policy page for takedown and legal requests. Set it — a public
# site with no route to reach a human is a site whose abuse you find out about
# on someone else's timeline.
WIKI_ABUSE_CONTACT=

# The operator token. On a public instance this is what separates a contributor
# whose edits go live from a stranger whose edits queue. It also gates the
# moderation queue. MUST be set here: with no token nobody can approve anything.
#   openssl rand -hex 32
WIKI_TOKEN=

# Writes per minute per address before a 429. This is the floor for when nothing
# is in front of the process; a real limiter belongs at the edge.
WIKI_WRITE_RATE=6

# Behind a reverse proxy, so X-Forwarded-For is the visitor and not the proxy.
# Only set this when something in front is genuinely setting that header —
# otherwise a client can name its own address in the edit record and evade a block.
WIKI_TRUST_PROXY=1

# Set to 1 to accept no writes at all. The strongest control there is, and worth
# starting here: nothing to moderate if nothing can be written.
WIKI_READONLY=0

# ---- MCP --------------------------------------------------------------------
# Bound to localhost deliberately. An open MCP endpoint answers an unauthenticated
# tools/list with the full tool set, including wiki_write and wiki_delete — a
# complete API reference handed to a port scan. Expose it only through the proxy,
# and only with a token.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8788

NODE_ENV=production
