# botwiki configuration — installed to /etc/botwiki.env
# Both services read this file. Restart them after editing.

# Where the markdown lives. This directory IS the wiki — back it up.
WIKI_DIR=/var/lib/botwiki/pages

# Browser UI + JSON API
WIKI_HOST=0.0.0.0
WIKI_PORT=8787
WIKI_TITLE=botwiki

# MCP endpoint agents connect to (streamable HTTP at /mcp)
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8788

# Shared secret for both services. Agents send it as `Authorization: Bearer <token>`;
# a browser sends it once as ?token=<token> and keeps it in a cookie.
# Leave empty ONLY on a network you fully trust — empty means no auth at all.
WIKI_TOKEN=

# Set to 1 to forbid all writes (agents get read-only tools, the UI hides editing).
WIKI_READONLY=0

NODE_ENV=production
