# botwiki configuration — installed to /etc/botwiki.env
# Both services read this file. Restart them after editing.

# Where the markdown lives. This directory IS the wiki — back it up.
WIKI_DIR=/var/lib/botwiki/pages

# Browser UI + JSON API
WIKI_HOST=0.0.0.0
WIKI_PORT=8787
WIKI_TITLE=botwiki

# Extra ports the same UI answers on, comma-separated. Set this to 80 on a LAN
# instance that has a DNS name, so http://wiki.example.net works with no port —
# WIKI_PORT keeps answering, so nothing that already points at :8787 breaks.
# A port below 1024 also needs deploy/botwiki-web-lowport.conf installed.
# WIKI_EXTRA_PORTS=80

# MCP endpoint agents connect to (streamable HTTP at /mcp)
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8788

# Shared secret for both services. Agents send it as `Authorization: Bearer <token>`;
# a browser sends it once as ?token=<token> and keeps it in a cookie.
# Leave empty ONLY on a network you fully trust — empty means no auth at all.
WIKI_TOKEN=

# Set to 1 to forbid all writes (agents get read-only tools, the UI hides editing).
WIKI_READONLY=0

# Attachments: images and files a page can point at, stored in .files/ inside
# WIKI_DIR and versioned by the hourly git snapshot along with the pages.
# Adds /files, POST /api/upload and the wiki_upload MCP tool.
#
# IGNORED on a public instance. Uploads cannot be moderated by reading them, so
# WIKI_PUBLIC always wins and uploads stay off — see the README.
# WIKI_FILES=1
# WIKI_MAX_FILE_BYTES=10485760
# WIKI_MAX_FILES_BYTES=536870912

NODE_ENV=production
